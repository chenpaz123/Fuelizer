NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Only needed for `supabase start` (local Auth server proxies Google OAuth
# through these). Not used by the deployed app — the Client ID/Secret for
# production live in the Supabase Dashboard, not here.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=<your-google-oauth-client-id>
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=<your-google-oauth-client-secret>

# Server-only (no NEXT_PUBLIC_ prefix — never exposed to the browser).
# Powers the receipt/dashboard photo OCR in actions/ocr.ts. Get a key at
# https://api.together.ai/settings/api-keys.
TOGETHER_API_KEY=<your-together-ai-api-key>
